# Safe local defaults only. Never place credentials or private keys in this file.
SERVICE_NAME=kppay-service-template
SERVICE_OWNER=kppay-platform
SERVICE_VERSION=development
DEPLOYMENT_ENVIRONMENT=local
SERVER_PORT=8080
KPPAY_SECURITY_JWT_ENABLED=false
KPPAY_SECURITY_JWT_ISSUER_URI=https://identity.example.invalid
KPPAY_SECURITY_JWT_AUDIENCES=kppay-api
OTEL_METRICS_EXPORT_ENABLED=false
OTEL_TRACES_EXPORT_ENABLED=false
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_TRACES_SAMPLER_PROBABILITY=0.1
CONSOLE_LOG_STRUCTURED_FORMAT=ecs
